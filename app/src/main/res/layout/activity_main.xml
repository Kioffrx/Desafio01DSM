<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/background"
    android:padding="@dimen/padding_screen">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/menu_titulo"
        android:textSize="@dimen/text_size_titulo"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="@dimen/margin_small" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/menu_subtitulo"
        android:textSize="@dimen/text_size_normal"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="@dimen/margin_large" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEjercicio1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginBottom="@dimen/margin_medium"
        android:text="@string/btn_ejercicio1"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/primary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEjercicio2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginBottom="@dimen/margin_medium"
        android:text="@string/btn_ejercicio2"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/primary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEjercicio3"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:text="@string/btn_ejercicio3"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/primary" />

</LinearLayout>