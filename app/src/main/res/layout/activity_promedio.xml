<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_screen">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/promedio_titulo"
            android:textSize="@dimen/text_size_titulo"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="@dimen/margin_medium" />

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/promedio_hint_nombre"
            android:inputType="textPersonName"
            android:layout_marginBottom="@dimen/margin_small" />

        <EditText
            android:id="@+id/etNota1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/promedio_nota1"
            android:inputType="numberDecimal"
            android:layout_marginBottom="@dimen/margin_small" />

        <EditText
            android:id="@+id/etNota2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/promedio_nota2"
            android:inputType="numberDecimal"
            android:layout_marginBottom="@dimen/margin_small" />

        <EditText
            android:id="@+id/etNota3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/promedio_nota3"
            android:inputType="numberDecimal"
            android:layout_marginBottom="@dimen/margin_small" />

        <EditText
            android:id="@+id/etNota4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/promedio_nota4"
            android:inputType="numberDecimal"
            android:layout_marginBottom="@dimen/margin_small" />

        <EditText
            android:id="@+id/etNota5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/promedio_nota5"
            android:inputType="numberDecimal"
            android:layout_marginBottom="@dimen/margin_medium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCalcularPromedio"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/promedio_btn_calcular"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/primary"
            android:layout_marginBottom="@dimen/margin_medium" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/surface">

            <TextView
                android:id="@+id/tvResultadoPromedio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/margin_medium"
                android:textSize="@dimen/text_size_resultado"
                android:textStyle="bold"
                android:gravity="center" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegresarMenu1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/margin_large"
            android:text="@string/btn_regresar_menu"
            app:cornerRadius="12dp"
            style="@style/Widget.Material3.Button.OutlinedButton" />

    </LinearLayout>
</ScrollView>